{
  "name": "pytop-pro-desktop",
  "version": "2.3.0",
  "private": true,
  "description": "pyTOP Pro Windows and Linux desktop system monitor",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.pytop.pro",
    "productName": "pyTOP Pro",
    "publish": [{ "provider": "github", "owner": "kkaan-42", "repo": "Pytop-Html", "releaseType": "release" }],
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{ "from": "backend", "to": "backend" }],
    "win": {
      "icon": "build/icon.svg",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "pyTOP-Pro-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.svg",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "System",
      "artifactName": "pyTOP-Pro-${version}-Linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pyTOP Pro",
      "installerLanguages": ["en_US", "tr_TR"],
      "language": "0x041f"
    }
  }
}
